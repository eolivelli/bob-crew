# CentOS Stream 9, for what UBI 9 does not have (qemu-kvm, libvirt). Lower priority than the UBI
# repositories, so UBI's packages win where both have one.
[cs9-baseos]
name=CentOS Stream 9 BaseOS
baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/$basearch/os/
gpgcheck=1
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256
priority=50

[cs9-appstream]
name=CentOS Stream 9 AppStream
baseurl=https://mirror.stream.centos.org/9-stream/AppStream/$basearch/os/
gpgcheck=1
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256
priority=50

[cs9-crb]
name=CentOS Stream 9 CRB
baseurl=https://mirror.stream.centos.org/9-stream/CRB/$basearch/os/
gpgcheck=1
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256
priority=50
