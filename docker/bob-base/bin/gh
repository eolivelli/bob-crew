#!/bin/sh
# The GitHub CLI with the session's token: read from its secret file when gh runs and handed to that gh
# process only, so that it is not in the agent's own environment. The file wins over a GH_TOKEN already in
# the environment, as in git-credential-bobcrew: the file is what a refresh of the session's secrets replaces,
# and a variable would go on holding the expired token. Without the file, the environment is used as it is.
dir="${BOBCREW_SECRETS_DIR:-/run/bobcrew/secrets}"
for name in GH_TOKEN GITHUB_TOKEN; do
  if [ -r "${dir}/${name}" ]; then
    GH_TOKEN="$(cat "${dir}/${name}")"
    export GH_TOKEN
    break
  fi
done
exec /usr/bin/gh "$@"
