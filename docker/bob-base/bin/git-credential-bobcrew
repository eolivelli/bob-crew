#!/bin/sh
# git credential helper for https://github.com (set up by profile.d/40-git.sh): answers with the session's
# GitHub token, read from its secret file each time git asks, so that the token is neither in the agent's
# environment nor copied to a credential store on disk. Falls back to GH_TOKEN / GITHUB_TOKEN in the
# environment, for sessions created through the API with env rather than secrets.
[ "${1:-}" = get ] || exit 0
dir="${BOBCREW_SECRETS_DIR:-/run/bobcrew/secrets}"
token=""
for name in GH_TOKEN GITHUB_TOKEN; do
  if [ -r "${dir}/${name}" ]; then
    token="$(cat "${dir}/${name}")"
    break
  fi
done
[ -n "${token}" ] || token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
[ -n "${token}" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "${token}"
